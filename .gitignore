# ── Scratch / temp workspace ─────────────────────────────────────────
/tmp/*
!/tmp/README.md

# ── OS / editor junk ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Node / Nuxt ──────────────────────────────────────────────────────
node_modules/
.nuxt/
.output/
.data/
.nitro/
.cache/
dist/

# ── Env / secrets ────────────────────────────────────────────────────
# Collapsed (S12): the enumerated form let .env.dev/.env.prod/.env.production/
# .env.staging/.env.bak/.env.old slip through untracked (none of `.env`,
# `.env.local`, `.env.*.local` matched them). `.env*` covers every dotted
# variant; the two negations below are load-bearing — both templates ARE
# tracked and must stay that way.
.env*
!.env.example
!.env.sandbox.example
# Sandbox deploy secrets — generated locally by az-deployment iteration.
# Never commit these. The deploy KV (Bicep-managed) is the persistent
# store; this file just lets us re-apply without re-generating.
# Generalised (S12) from `.azure-*-secrets.env`: same reasoning applies to
# any `*secrets.env` file, not just the azure-prefixed one.
*secrets.env
# Personal copies of the example parameter files (docs/DEPLOY-AZURE.md).
infra/parameters/my*.bicepparam

# ── Test artefacts ───────────────────────────────────────────────────
coverage/
playwright-report/
playwright/.cache/
test-results/
/.playwright-cli/

# ── Logs ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── cw worker-local auto-managed files ───────────────────────────────
# Everything in .claude/ is machine-local (cw-managed CLAUDE.md, worktrees,
# settings.local.json) EXCEPT settings.json — the team-shared hooks
# (release-notes gate, wiki gate) ride the repo.
.claude/*
!.claude/settings.json

# ── TokenScope plugin session env (never commit; carries session_token) ──
.tokenscope.env
# Per-project Copilot forwarder telemetry/state (span file, offset, lock) — the
# forwarder also self-heals this entry at runtime, but ignore it here too so
# dogfooding TokenScope on this very repo never stages its own telemetry.
.tokenscope.local/
.claude-audit/

# ── Bicep compile artifacts (we ship .bicep + .bicepparam, not .json) ──
infra/*.json
infra/modules/*.json
infra/parameters/*.json

# Local-only sandbox repro harness (needs --no-save @opentelemetry/* exporter
# packages the app never ships; verified recipes are in
# docs/development/claude-code-telemetry-contract.md and sandbox-realclaude-journey.md).
scripts/spikes/

# Node/V8 core dumps (e.g. from an OOM during build)
core
core.*
# TokenScope repo tag (carries device config; do not commit)
.claude/settings.local.json
# Security-audit machine outputs: SARIF goes to code scanning, the SBOM is regenerated per run
docs/security-audit-output/findings.sarif
docs/security-audit-output/findings.cyclonedx.json
