{
  "name": "tokenscope",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "TokenScope — Usage-Based Token Attribution Platform (Insight). Slogan: Trust the developer. Track every token. Let the budget do the teaching.",
  "scripts": {
    "build": "bash scripts/build.sh",
    "dev": "bash scripts/dev.sh",
    "dev:stack": "bash scripts/dev-stack.sh up",
    "dev:stack:down": "bash scripts/dev-stack.sh down",
    "dev:stack:status": "bash scripts/dev-stack.sh status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env drizzle/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env drizzle/seed.ts",
    "db:seed:regions": "tsx --env-file-if-exists=.env drizzle/seed-regions.ts",
    "db:seed:org-structure": "tsx drizzle/seed-org-structure.ts",
    "db:provision-app-role": "tsx drizzle/provision-app-role.ts",
    "db:cutover-rls-sweep": "tsx drizzle/cutover-rls-sweep.ts",
    "db:seed:reporting-fixture": "tsx scripts/seed-reporting-fixture.ts",
    "emit:data": "tsx --env-file-if-exists=.env scripts/emit-data.ts",
    "emit:stream": "tsx --env-file-if-exists=.env scripts/emit-stream.ts",
    "worker": "tsx scripts/run-worker.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "typecheck:types": "tsc -p tsconfig.type-tests.json",
    "typecheck:server": "nuxt prepare && tsc -p .nuxt/tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "sync:copilot-plugin": "node scripts/sync-copilot-plugin.mjs",
    "check:copilot-plugin-sync": "node scripts/check-copilot-plugin-sync.mjs",
    "check:copilot-extension-isolation": "node scripts/copilot-extension-isolation-check.mjs",
    "check:claude-emission-local": "tsx --env-file-if-exists=.env tests/e2e/real-claude-spike.ts",
    "check:copilot-usage-e2e": "node scripts/copilot-usage-e2e.mjs",
    "sync:skill-prompts": "node scripts/sync-skill-prompts.mjs",
    "check:docs-references": "node scripts/check-docs-references.mjs",
    "check:skill-prompts-sync": "node scripts/check-skill-prompts-sync.mjs",
    "check:prototype-inventory": "node scripts/emit-prototype-inventory.mjs --check",
    "check:prototype-frozen": "node scripts/check-prototype-frozen.mjs",
    "emit:prototype-inventory": "node scripts/emit-prototype-inventory.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "bash tests/e2e/run-e2e.sh",
    "coverage:estate": "tsx scripts/coverage-estate.ts",
    "coverage:serve": "PORT=3450 bash scripts/dev.sh",
    "coverage:walk": "node scripts/coverage-walk.mjs",
    "test:fidelity": "bash tests/fidelity/check.sh",
    "test:smoke": "bash tests/smoke/run-smoke.sh",
    "test:nav": "node tests/smoke/admin-nav-timing.mjs",
    "test:reap": "docker ps -aq --filter label=tokenscope.test=true | xargs -r docker rm -f && echo 'reaped orphaned tokenscope test containers'"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/monitor-query": "^1.3.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nuxt/ui": "^4.10.0",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "nuxt": "^4.5.0",
    "nuxt-echarts": "^1.1.0",
    "nuxt-oidc-auth": "1.0.0-beta.12",
    "nuxt-security": "^2.5.0",
    "postgres": "^3.4.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.1",
    "@playwright/cli": "^0.1.21",
    "@playwright/test": "^1.63.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.0",
    "playwright-chromium": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "overrides": {
    "tmp": ">=0.2.6",
    "esbuild": ">=0.25.0",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.8",
    "@unhead/vue": "^3.2.3",
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "^2.0.5"
    }
  }
}
